{
  "info": {
    "name": "Mini Wallet API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run folder 1 first, then folder 2. Start the app on localhost:8080 with an empty DB."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "rahulId",
      "value": ""
    },
    {
      "key": "priyaId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Happy path",
      "item": [
        {
          "name": "Create wallet - Rahul",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/wallets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "wallets"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul\",\n  \"email\": \"rahul@example.com\",\n  \"initialBalance\": 1000.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"rahulId\", pm.response.json().walletId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create wallet - Priya",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/wallets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "wallets"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Priya\",\n  \"email\": \"priya@example.com\",\n  \"initialBalance\": 500.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"priyaId\", pm.response.json().walletId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Deposit 500 into Rahul",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/wallets/{{rahulId}}/deposit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "wallets",
                "{{rahulId}}",
                "deposit"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 500.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"balance 1500\", ()=>pm.expect(pm.response.json().currentBalance).to.eql(1500));"
                ]
              }
            }
          ]
        },
        {
          "name": "Transfer 300 Rahul -> Priya",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/wallets/transfer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "wallets",
                "transfer"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromWalletId\": \"{{rahulId}}\",\n  \"toWalletId\": \"{{priyaId}}\",\n  \"amount\": 300.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"SUCCESS\", ()=>pm.expect(pm.response.json().status).to.eql(\"SUCCESS\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Rahul wallet (balance 1200)",
          "request": {
            "method": "GET",
            "header": [
              {
